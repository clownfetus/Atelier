<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(MeshAssemblies)/*.dll"
      Exclude="$(MeshAssemblies)/System.*;$(MeshAssemblies)/Microsoft.*;$(MeshAssemblies)/mscorlib.dll;$(MeshAssemblies)/netstandard.dll;$(MeshAssemblies)/WindowsBase.dll;$(MeshAssemblies)/AtelierMesh.dll" />
  </ItemGroup>
</Project>

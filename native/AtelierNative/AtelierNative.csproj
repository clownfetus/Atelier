<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Atelier's own native helper: mesh export, idle animation decoding, the persistent import
    server and the morph-buffer checker, all built against ONE pinned CUE4Parse.

    CUE4Parse is built from source at the commit pinned in toolchain/tools.lock.json (NuGet
    releases lag Marvel Rivals' mapping format, and CUE4Parse-Natives is not on NuGet at all).
    scripts/toolchain.py checks the source out and passes -p:Cue4ParseSource=<checkout>.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AtelierNative</AssemblyName>
    <RootNamespace>Atelier.Native</RootNamespace>
    <Version>2.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/atelier-native</PathMap>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8604</NoWarn>
  </PropertyGroup>
  <Target Name="RequireCue4ParseSource" BeforeTargets="ResolveProjectReferences"
          Condition="'$(Cue4ParseSource)' == '' Or !Exists('$(Cue4ParseSource)/CUE4Parse/CUE4Parse.csproj')">
    <Error Text="Set Cue4ParseSource to a CUE4Parse checkout at the pinned commit (scripts/toolchain.py build does this)." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="$(Cue4ParseSource)/CUE4Parse/CUE4Parse.csproj" />
    <ProjectReference Include="$(Cue4ParseSource)/CUE4Parse-Conversion/CUE4Parse-Conversion.csproj" />
  </ItemGroup>
</Project>

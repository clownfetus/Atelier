          "linux": "retoc-rivals-cli-x86_64-unknown-linux-gnu.tar.xz"
        }
      },
      "version": "3.10.2",
      "description": "IoStore container unpack/pack (upstream retoc-rivals-cli; follows game patches)",
      "license": "MIT OR Apache-2.0",

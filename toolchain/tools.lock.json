{
  "schema": 1,
  "comment": "Every native tool Atelier ships, where it comes from, and the hashes it must match. scripts/toolchain.py fetches, builds and verifies against this file; nothing in Tools/ is committed. 'updatable' tools follow game patches and may be replaced in the field by the verified in-app updater (toolchain/channel.json).",
  "sources": {
    "cue4parse": {
      "repo": "https://github.com/FabianFG/CUE4Parse",
      "commit": "ea85cf20d8df53556f399c5fabc2befb46b65d0d",
      "submodules": [
        "CUE4Parse-Natives/ACL/external/acl"
      ],
      "license": "Apache-2.0",
      "note": "The exact commit inside the AtelierMesh/AtelierAnimation binaries shipped through 1.1.0 (assembly version 1.2.2+ea85cf20d8)."
    },
    "uassettool": {
      "repo": "https://github.com/X-zant/UAssetToolRivals",
      "commit": "deb6f32fef1fbc8d6b6cfd37588627d62ddb3bcf",
      "patches": "toolchain/patches/UAssetToolRivals",
      "license": "GPL-3.0"
    },
    "ooz": {
      "repo": "https://github.com/powzix/ooz",
      "commit": "05038060aa68f9187ae9923b2388ca8db40e58d1",
      "license": "GPL-3.0"
    },
    "retoc-rivals": {
      "repo": "https://github.com/natimerry/retoc-rivals",
      "commit": "e6c985eac480275348976dcc6e8729c1de1bef40",
      "license": "MIT OR Apache-2.0",
      "note": "Fetched as a hash-pinned archive by scripts/build_shader_tool.py; exact inputs (with repak-rivals, Rust and llvm-mingw) are in native/AtelierShader/build.lock.json."
    }
  },
  "tools": [
    {
      "name": "AtelierNative",
      "kind": "build",
      "builder": "atelier-native",
      "platforms": [
        "windows",
        "linux"
      ],
      "description": "Mesh export, idle animations, persistent imports (native/AtelierNative, CUE4Parse pinned above)",
      "files": {
        "windows": [
          "AtelierNative/AtelierNative.exe",
          "AtelierNative/CUE4Parse-Natives.dll"
        ],
        "linux": [
          "AtelierNative/AtelierNative",
          "AtelierNative/CUE4Parse-Natives.so"
        ]
      },
      "probe": {
        "args": [
          "version"
        ],
        "expect": [
          "AtelierNative",
          "natives ok"
        ]
      },
      "license": "GPL-3.0 (Atelier) with CUE4Parse under Apache-2.0",
      "source": "native/AtelierNative in this repository; CUE4Parse at the commit above"
    },
    {
      "name": "UAssetTool",
      "kind": "build",
      "builder": "uassettool",
      "platforms": [
        "windows",
        "linux"
      ],
      "description": "Asset JSON, texture inject/extract, IoStore mod builds (UAssetToolRivals + Atelier patches)",
      "files": {
        "windows": [
          "UAssetTool.exe"
        ],
        "linux": [
          "UAssetTool"
        ]
      },
      "probe": {
        "args": [
          "version"
        ],
        "expect": [
          "UAssetTool v"
        ]
      },
      "license": "GPL-3.0 (UAssetToolRivals; bundles UAssetAPI, MIT)",
      "source": "https://github.com/X-zant/UAssetToolRivals at the commit above, plus toolchain/patches/UAssetToolRivals"
    },
    {
      "name": "retoc",

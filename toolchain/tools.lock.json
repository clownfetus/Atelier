            }
          }
        },
        "linux": {
          "url": "https://github.com/natimerry/repak-rivals/releases/download/v3.10.2/retoc-rivals-cli-x86_64-unknown-linux-gnu.tar.xz",
          "sha256": "dd3795d49f325b586042bfa69386caf18f04ea8c5143e68c5e4bce1526fc5358",
          "extract": {
            "retoc-rivals-cli-x86_64-unknown-linux-gnu/retoc-rivals-cli": {

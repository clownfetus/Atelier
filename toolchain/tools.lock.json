      "source": "https://github.com/natimerry/repak-rivals"
    },
    {
      "name": "retoc-shaders",
      "kind": "build",
      "builder": "atelier-shader",
      "platforms": [
        "windows"
      ],
      "version": "3.10.2-atelier.1",
      "description": "Shader-capable retoc (dump/extract/patch shader libraries): native/AtelierShader's commands on pinned upstream retoc-rivals, built with a pinned Rust/llvm-mingw toolchain",
      "files": {
        "windows": [
          "shaders/retoc-rivals-cli.exe",
          "shaders/build-inputs.json",
          "shaders/licenses/repak-MIT.txt",
          "shaders/licenses/repak-APACHE.txt",
          "shaders/licenses/retoc-MIT.txt"
        ]
      },
      "reproducible": {
        "shaders/retoc-rivals-cli.exe": "3eaf66d4e48b13d00e63c46e5703e709556af709dc51b54c1d09c8b4b9c49165"
      },
      "probe": {
        "args": [
          "--help"
        ],
        "expect": [
          "dump-shaders",
          "extract-shader",
          "patch-shader",
          "pack",
          "unpack",
          "info"
        ]
      },
      "license": "MIT OR Apache-2.0 (retoc-rivals, repak-rivals, Atelier shader commands)",
      "source": "native/AtelierShader on natimerry/retoc-rivals@e6c985e (inputs: native/AtelierShader/build.lock.json)"
    },

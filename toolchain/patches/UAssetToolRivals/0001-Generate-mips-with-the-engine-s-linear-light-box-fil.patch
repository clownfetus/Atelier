     }
     
+    /// <summary>
+    /// Compress BC7 mips with DirectXTex texconv when UASSETTOOL_TEXCONV points at it (Windows):
+    /// ~10x faster than BCnEncoder (GPU when available), measured with no colour shift. The pixels
+    /// are compressed as-is (BC7_UNORM, no colour-space conversion): the texture's SRGB flag is a
+    /// sampling property and does not change the stored blocks. Returns null to fall back.
+    /// </summary>
+    private static List<CompressedMip>? TexconvCompress(List<Image<Rgba32>> mips)
+    {
+        var texconv = Environment.GetEnvironmentVariable("UASSETTOOL_TEXCONV");
+        if (string.IsNullOrEmpty(texconv) || !File.Exists(texconv)) return null;
+        var work = Path.Combine(Path.GetTempPath(), "uat-texconv-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(work);
+        try
+        {
+            var inputs = new List<string>();
+            for (int i = 0; i < mips.Count; i++)
+            {
+                // texconv's GPU encoder mishandles partial blocks (a 3x3 mip read back as flat
+                // grey), and every full chain ends in 2x2/1x1 mips. Pad to whole 4x4 blocks by
+                // repeating edge pixels -- the same blocks the built-in encoder stores.
+                var png = Path.Combine(work, $"mip{i:D2}.png");
+                using (var padded = PadToBlocks(mips[i])) padded.SaveAsPng(png);
+                inputs.Add(png);
+            }
+            var psi = new System.Diagnostics.ProcessStartInfo(texconv)
+            {
+                UseShellExecute = false, CreateNoWindow = true,
+                RedirectStandardOutput = true, RedirectStandardError = true,
+            };
+            foreach (var a in new[] { "-nologo", "-y", "-f", "BC7_UNORM", "-m", "1", "-o", work }) psi.ArgumentList.Add(a);
+            foreach (var png in inputs) psi.ArgumentList.Add(png);
+            using var proc = System.Diagnostics.Process.Start(psi)!;
+            proc.StandardOutput.ReadToEnd(); proc.StandardError.ReadToEnd();
+            if (!proc.WaitForExit(600_000) || proc.ExitCode != 0) return null;
+            var output = new List<CompressedMip>();
+            for (int i = 0; i < mips.Count; i++)
+            {
+                var dds = File.ReadAllBytes(Path.ChangeExtension(inputs[i], ".dds"));
+                int w = mips[i].Width, h = mips[i].Height;
+                int size = Math.Max(1, (w + 3) / 4) * Math.Max(1, (h + 3) / 4) * 16;
+                // DDS magic + 124-byte header, plus the 20-byte DX10 header that BC7 always carries.
+                const int offset = 4 + 124 + 20;
+                if (dds.Length < offset + size || BitConverter.ToUInt32(dds, 0) != 0x20534444) return null;
+                output.Add(new CompressedMip(w, h, dds.AsSpan(offset, size).ToArray()));
+            }
+            Console.WriteLine($"  Compressed {mips.Count} BC7 mip(s) with texconv");
+            return output;
+        }
+        catch (Exception e)
+        {
+            Console.WriteLine($"  texconv unavailable ({e.Message}); using the built-in encoder");
+            return null;
+        }
+        finally
+        {
+            try { Directory.Delete(work, true); } catch { }
+        }
+    }
+
+    private static Image<Rgba32> PadToBlocks(Image<Rgba32> source)
+    {
+        int w = source.Width, h = source.Height;
+        int pw = (w + 3) / 4 * 4, ph = (h + 3) / 4 * 4;
+        if (pw == w && ph == h) return source.Clone();
+        var src = new Rgba32[w * h];
+        source.CopyPixelDataTo(src);
+        var dst = new Rgba32[pw * ph];
+        for (int y = 0; y < ph; y++)
+            for (int x = 0; x < pw; x++)
+                dst[y * pw + x] = src[Math.Min(y, h - 1) * w + Math.Min(x, w - 1)];
+        return Image.LoadPixelData<Rgba32>(dst, pw, ph);
+    }
+
     /// <summary>
     /// Get BCnEncoder format from our enum.
     /// </summary>

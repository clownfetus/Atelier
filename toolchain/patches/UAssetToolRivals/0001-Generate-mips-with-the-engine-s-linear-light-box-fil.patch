@@ -325,22 +326,80 @@ public class TextureInjector
     
     /// <summary>
     /// Generate the FULL mipmap chain down to 1x1 (cooked UE convention), e.g. 4096 -> 13 mips.
+    ///
+    /// Each level is a 2x2 box average of the previous one, the engine's default (SimpleAverage)
+    /// mip filter. For sRGB textures the average is taken in linear light, as the engine does:
+    /// averaging the encoded sRGB values instead darkens every mip (measured on Marvel Rivals
+    /// character textures: -0.4 levels at mip 1 growing to -4.3 by mip 5, while the linear filter
+    /// reproduces the game's own mips with ~0 bias). Alpha is averaged straight, never
+    /// premultiplied: Rivals uses the alpha channel of many textures as a data mask.
     /// </summary>
-    private static List<Image<Rgba32>> GenerateFullMipChain(Image<Rgba32> source)
+    private static List<Image<Rgba32>> GenerateFullMipChain(Image<Rgba32> source, bool srgb)
     {
         var mips = new List<Image<Rgba32>> { source.Clone() };
-        int width = source.Width, height = source.Height;
-        while (width > 1 || height > 1)
-        {
-            width = Math.Max(1, width / 2);
-            height = Math.Max(1, height / 2);
-            var mip = source.Clone();
-            mip.Mutate(x => x.Resize(width, height));
-            mips.Add(mip);
-        }
+        while (mips[^1].Width > 1 || mips[^1].Height > 1)
+            mips.Add(HalveBox(mips[^1], srgb));
         return mips;
     }
 
+    private static readonly float[] SrgbToLinearLut = Enumerable.Range(0, 256).Select(i =>
+    {
+        double c = i / 255.0;
+        return (float)(c <= 0.04045 ? c / 12.92 : Math.Pow((c + 0.055) / 1.055, 2.4));
+    }).ToArray();
+
+    private static byte LinearToSrgbByte(float linear)
+    {
+        double l = Math.Clamp(linear, 0f, 1f);
+        double c = l <= 0.0031308 ? l * 12.92 : 1.055 * Math.Pow(l, 1.0 / 2.4) - 0.055;
+        return (byte)Math.Clamp((int)Math.Round(c * 255.0), 0, 255);
+    }
+
+    private static Image<Rgba32> HalveBox(Image<Rgba32> source, bool srgb)
+    {
+        int w = source.Width, h = source.Height;
+        int w2 = Math.Max(1, w / 2), h2 = Math.Max(1, h / 2);
+        var src = new Rgba32[w * h];
+        source.CopyPixelDataTo(src);
+        var dst = new Rgba32[w2 * h2];
+        System.Threading.Tasks.Parallel.For(0, h2, y =>
+        {
+            int y0 = Math.Min(2 * y, h - 1), y1 = Math.Min(2 * y + 1, h - 1);
+            for (int x = 0; x < w2; x++)
+            {
+                int x0 = Math.Min(2 * x, w - 1), x1 = Math.Min(2 * x + 1, w - 1);
+                Rgba32 a = src[y0 * w + x0], b = src[y0 * w + x1], c = src[y1 * w + x0], d = src[y1 * w + x1];
+                byte alpha = (byte)((a.A + b.A + c.A + d.A + 2) / 4);
+                if (srgb)
+                {
+                    var lut = SrgbToLinearLut;
+                    dst[y * w2 + x] = new Rgba32(
+                        LinearToSrgbByte((lut[a.R] + lut[b.R] + lut[c.R] + lut[d.R]) * 0.25f),
+                        LinearToSrgbByte((lut[a.G] + lut[b.G] + lut[c.G] + lut[d.G]) * 0.25f),
+                        LinearToSrgbByte((lut[a.B] + lut[b.B] + lut[c.B] + lut[d.B]) * 0.25f), alpha);
+                }
+                else
+                {
+                    dst[y * w2 + x] = new Rgba32((byte)((a.R + b.R + c.R + d.R + 2) / 4),
+                        (byte)((a.G + b.G + c.G + d.G + 2) / 4), (byte)((a.B + b.B + c.B + d.B + 2) / 4), alpha);
+                }
+            }
+        });
+        return Image.LoadPixelData<Rgba32>(dst, w2, h2);
+    }
+
+    /// <summary>
+    /// Whether the texture samples as sRGB. UTexture::SRGB defaults to true and is only serialized
+    /// when it differs from the default, so an absent property means sRGB.
+    /// </summary>
+    private static bool IsSrgb(TextureExport tex)
+    {
+        foreach (var prop in tex.Data)
+            if (prop is UAssetAPI.PropertyTypes.Objects.BoolPropertyData b && b.Name?.Value?.Value == "SRGB")
+                return b.Value;
+        return true;
+    }
+
